        if (!Plugin::isLoaded('CakeDC/Mcp')) {
            Plugin::getCollection()->add(new McpPlugin());
        }
    }

    public function testThePageRenders(): void
    {
        $page = (new {{ className }}())->page();

        $this->assertSame('text/html;profile=mcp-app', $page->mimeType);
        $this->assertStringContainsString('McpApps', $page->text);
    }

    public function testTheToolAnswers(): void
    {
        $this->mcpActingAs(['id' => 1]);

        $this->mcpCallTool('show_{{ mcpName }}');

        $this->assertMcpToolSucceeded();
    }
