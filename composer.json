{
    "name": "cakedc/cakephp-mcp",
    "description": "Model Context Protocol (MCP) server for CakePHP: expose tools, resources and prompts to Claude and other MCP clients over HTTP or stdio",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": ["cakephp", "mcp", "model context protocol", "ai", "claude", "llm"],
    "authors": [
        {
            "name": "Cake Development Corporation",
            "homepage": "https://www.cakedc.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.0",
        "mcp/sdk": "dev-main#82e19d114e95671e05e7df7909195f7ace03d90e as 0.9.0",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "cakedc/auth": "^10.1 || ^11.0",
        "cakephp/authentication": "^3.3",
        "cakephp/cakephp-codesniffer": "^5.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.1 || ^13.0"
    },
    "suggest": {
        "cakephp/authentication": "Identifies the caller of the MCP endpoint (for example with a Bearer token authenticator)",
        "cakedc/auth": "Enables RbacToolAuthorizer, per-tool permissions in the config/permissions.php format"
    },
    "autoload": {
        "psr-4": {
            "CakeDC\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CakeDC\\Mcp\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
